{
  "expo": {
    "name": "MandarinAI",
    "slug": "mandarinai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon-red-1024.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mandarinai",
      "icon": "./assets/app-icon-ios-1024.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "MandarinAI uses the microphone so you can rehearse Mandarin out loud and receive pronunciation feedback.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-red-1024.png",
        "backgroundColor": "#E63946"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "app.mandarinai",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-av",
      [
        "expo-notifications",
        {
          "color": "#E63946"
        }
      ]
    ],
    "scheme": "mandarinai",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d365481-3eca-4cbd-989c-d3dbc2287a23"
      }
    },
    "owner": "serafym26",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3d365481-3eca-4cbd-989c-d3dbc2287a23"
    }
  }
}
